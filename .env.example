# Optional Gemini coach
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Flask server
# Use 0.0.0.0 only when a trusted local network or reverse proxy needs access.
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
TALKMATE_MAX_REQUEST_BYTES=102400

# Set this to a long random value before deploying.
TALKMATE_SECRET_KEY=replace-with-a-long-random-secret
# Set true only when the app is served over HTTPS.
TALKMATE_SESSION_SECURE=false

# Optional: path to the local SQLite database.
# TALKMATE_DB=talkmate.db
