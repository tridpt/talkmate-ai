# Optional Gemini coach
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Flask server
# Use 0.0.0.0 only when a trusted local network or reverse proxy needs access.
TALKMATE_ENV=development
FLASK_HOST=127.0.0.1
FLASK_PORT=5001
FLASK_DEBUG=false
TALKMATE_MAX_REQUEST_BYTES=102400

# Set this to a long random value before a manual public deployment.
TALKMATE_SECRET_KEY=
# Set true only when the app is served over HTTPS.
TALKMATE_SESSION_SECURE=false
# Set true only behind one trusted reverse proxy, such as Render.
TALKMATE_TRUST_PROXY=false

# Optional: path to the local SQLite database.
# TALKMATE_DB=talkmate.db
# Wait briefly for a concurrent SQLite write instead of failing immediately.
TALKMATE_DB_TIMEOUT_SECONDS=10
